<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="#F6F8FB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="20dp"
        android:paddingBottom="28dp">

        <!-- HEADER -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="#1976D2"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔋 Charge Alarm"
                    android:textColor="#FFFFFF"
                    android:textSize="28sp"
                    android:textStyle="bold"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Smart charging monitor"
                    android:textColor="#DCEBFF"
                    android:textSize="13sp"
                    android:layout_marginTop="3dp"/>

                <TextView
                    android:id="@+id/tvStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● Siaga • Menunggu charger"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginTop="18dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- LIVE DASHBOARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="STATUS CHARGING"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="#64748B"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/tvBatteryNow"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="--%"
                        android:textSize="38sp"
                        android:textStyle="bold"
                        android:textColor="#0F172A"/>

                    <TextView
                        android:id="@+id/tvTemperature"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🌡️ --°C"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#475569"/>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSpeed"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚡ Menghitung kecepatan…"
                    android:textSize="14sp"
                    android:textColor="#334155"
                    android:layout_marginTop="12dp"/>

                <TextView
                    android:id="@+id/tvEta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⏱️ ETA --"
                    android:textSize="14sp"
                    android:textColor="#334155"
                    android:layout_marginTop="5dp"/>

                <TextView
                    android:id="@+id/tvSession"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Belum ada sesi charging aktif"
                    android:textSize="13sp"
                    android:textColor="#64748B"
                    android:layout_marginTop="8dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TARGET -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvLimit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Batas Baterai: 80%"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2"
                    android:gravity="center"
                    android:layout_marginBottom="8dp"/>

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="50"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="50%                                  100%"
                    android:textSize="11sp"
                    android:textColor="#94A3B8"
                    android:gravity="center"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TTS -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🗣️ Text-to-Speech"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"/>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchTts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Ucapkan peringatan saat target tercapai"
                    android:textSize="14sp"
                    android:checked="true"
                    android:layout_marginTop="4dp"/>

                <EditText
                    android:id="@+id/etTtsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Baterai sudah {percent} persen, silakan cabut charger."
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="200"
                    android:minHeight="82dp"
                    android:gravity="top|start"
                    android:textSize="14sp"
                    android:padding="12dp"
                    android:backgroundTint="#CBD5E1"
                    android:layout_marginTop="6dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gunakan {percent} untuk persentase saat alarm dan {batas} untuk target. TTS akan mengulang sampai alarm dihentikan atau charger dicabut."
                    android:textSize="11sp"
                    android:textColor="#64748B"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- TEMPERATURE -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🌡️ Temperature Warning"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"/>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchTempWarning"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Peringatkan jika baterai terlalu panas"
                    android:textSize="14sp"
                    android:checked="true"/>

                <TextView
                    android:id="@+id/tvTempLimit"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Peringatan suhu: 42°C"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#E65100"
                    android:gravity="center"
                    android:layout_marginTop="5dp"/>

                <SeekBar
                    android:id="@+id/seekBarTemp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="15"
                    android:layout_marginTop="2dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="35°C                                  50°C"
                    android:textSize="11sp"
                    android:textColor="#94A3B8"
                    android:gravity="center"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- SOUND -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔊 Alarm &amp; Pengaturan"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#0F172A"/>

                <TextView
                    android:id="@+id/tvVolume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔊 Volume Alarm: 80%"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1976D2"
                    android:gravity="center"
                    android:layout_marginTop="12dp"/>

                <SeekBar
                    android:id="@+id/seekBarVolume"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="100"
                    android:progress="80"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnTestSound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="▶  Test suara alarm (3 detik)"
                    android:textStyle="bold"
                    app:cornerRadius="14dp"
                    android:layout_marginTop="4dp"/>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔊 Bunyikan suara alarm"
                    android:checked="true"/>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchVibrate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📳 Getarkan HP"
                    android:checked="true"/>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchSnooze"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⏰ Tombol Tunda (1 menit)"
                    android:checked="true"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- AUTO MODE -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="1dp"
            app:cardBackgroundColor="#FFFFFF"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAutoMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔌 Auto-start saat charger dicolok"
                    android:textSize="15sp"
                    android:checked="true"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Saat charger dicabut, alarm dan monitoring otomatis berhenti."
                    android:textSize="11sp"
                    android:textColor="#64748B"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ACTIONS -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="▶  AKTIFKAN ALARM"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#16A34A"
            app:cornerRadius="16dp"
            android:layout_marginBottom="10dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnStop"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="■  MATIKAN ALARM"
            android:textSize="15sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:backgroundTint="#DC2626"
            app:cornerRadius="16dp"
            android:layout_marginBottom="10dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnHistory"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="📊 Riwayat"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                android:layout_marginEnd="5dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBattOpt"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:text="🔋 Background"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                android:layout_marginStart="5dp"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnClearHistory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Hapus riwayat charging"
            android:textSize="12sp"
            android:textColor="#64748B"
            android:backgroundTint="@android:color/transparent"
            app:cornerRadius="12dp"
            android:layout_marginTop="2dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💡 Untuk monitoring yang stabil, izinkan aplikasi berjalan di background dan matikan optimasi baterai jika diperlukan oleh perangkat."
            android:textSize="11sp"
            android:textColor="#64748B"
            android:gravity="center"
            android:lineSpacingExtra="3dp"
            android:layout_marginTop="10dp"/>

    </LinearLayout>
</ScrollView>
